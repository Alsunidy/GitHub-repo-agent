# انسخ هذا الملف إلى .env واملأ القيم. لا تُضِف .env إلى git إطلاقاً.

# --- مزوّد الـ LLM ---
# anthropic | openai | google
LLM_PROVIDER=anthropic
# اختياري: يتجاوز الموديل الافتراضي للمزوّد
# LLM_MODEL=

# مفتاح المزوّد المختار فقط:
# console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# platform.openai.com/api-keys
# OPENAI_API_KEY=
# aistudio.google.com/apikey
# GOOGLE_API_KEY=

# --- GitHub ---
# مطلوب لرفع حد الاستعلامات (60/ساعة بدونه) ولفتح البلاغات.
# github.com/settings/tokens → Fine-grained token
# الصلاحيات: Contents=Read، Issues=Read and write، Metadata=Read
GITHUB_TOKEN=
