# ASCII only, same reason as requirements.txt: this file gets copied to .env and
# read by tools that may not assume UTF-8 on Windows.
#
# Copy to .env and fill in the values. Never commit .env, and never put real
# keys in this file -- this is the template that ships with the repo.

# --- LLM provider ---
# openai | openrouter | anthropic | google
LLM_PROVIDER=openai
# Optional: overrides the provider's default model.
# openai -> gpt-4o-mini | openrouter -> openai/gpt-4o-mini
# LLM_MODEL=

# Only the key for the provider you chose:
# platform.openai.com/api-keys          (keys start with sk-)
OPENAI_API_KEY=
# openrouter.ai/keys                    (keys start with sk-or-v1)
# OPENROUTER_API_KEY=
# console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# aistudio.google.com/apikey
# GOOGLE_API_KEY=

# --- GitHub ---
# Needed to raise the rate limit (60/hour without it) and to open issues.
# github.com/settings/tokens -> Fine-grained token
# Permissions: Contents=Read, Issues=Read and write, Metadata=Read
GITHUB_TOKEN=
